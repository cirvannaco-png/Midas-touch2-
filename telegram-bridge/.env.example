BOT_TOKEN=123456:ABC-DEF1234gh
CHAT_ID=-1001234567890
# Chat allowed to run bot commands (/positions, /risk ...). Normally your
# personal DM with the bot, so signal-group members can't query trading data.
ADMIN_CHAT_ID=123456789
SECRET_KEY=replace_with_a_strong_random_string

# Inbound bot (commands like /start, /positions, /risk). Telegram signs
# every webhook delivery with this token; generate any long random string.
# Must match ^[A-Za-z0-9_-]{1,256}$ (Telegram's requirement) - generate with:
#   openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=replace_with_a_strong_random_string

# Render sets RENDER_EXTERNAL_URL automatically on web services - you
# normally don't need to set WEBHOOK_URL yourself. Only set it for local
# testing via a tunnel (e.g. ngrok), where it should be the full public
# https URL Telegram can reach, e.g. https://abcd1234.ngrok.app
WEBHOOK_URL=

# For local SQLite development:
DATABASE_URL=sqlite+aiosqlite:///./signals.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/medis_touch

LOG_LEVEL=INFO

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

MAX_REQUEST_BODY_SIZE=10240

# Comma-separated list, only needed if a browser client will call this API.
# Leave empty for EA-only traffic (no CORS applies to server-to-server calls).
ALLOWED_ORIGINS=

# Keep TELEGRAM_TIMEOUT_SECONDS * TELEGRAM_MAX_RETRIES (roughly, accounting
# for backoff) comfortably under the EA's SignalPublisher WebRequest timeout,
# or the EA will consider a send "failed" and may resend under a new
# signal_id while the backend is still retrying the original.
TELEGRAM_TIMEOUT_SECONDS=8
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_MAX_WAIT_SECONDS=4

# How long a PENDING row must be stuck (seconds) before /retry-failed treats it as
# stale and reclaims it. Set this comfortably above TELEGRAM_TIMEOUT_SECONDS *
# TELEGRAM_MAX_RETRIES so a slow-but-still-running send isn't reclaimed early.
PENDING_STALE_SECONDS=120

# Optional second broadcast destination — signals/trade alerts fan out to
# CHAT_ID *and* GROUP_CHAT_ID when this is set. Also the group
# app/group_enforcement.py removes non-paying subscribers from once their
# grace period lapses.
GROUP_CHAT_ID=

# ---- Subscriptions / payments (app/subscriptions.py, app/payments_bot.py) ----
# Empty = Telegram Stars (XTR): no external merchant account, Telegram itself
# settles the transaction. Set this (from @BotFather -> Payments) only if you
# want a real-currency provider (Stripe etc.) instead.
SUBSCRIPTION_PROVIDER_TOKEN=
SUBSCRIPTION_CURRENCY=XTR
# Placeholder — set your real plan price before taking live payments.
SUBSCRIPTION_PRICE_AMOUNT=500
SUBSCRIPTION_PERIOD_DAYS=30
# Days after expiry before group_enforcement.py actually removes someone
# from GROUP_CHAT_ID.
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
# How far before expiry to send the one-time "you're about to expire" DM.
SUBSCRIPTION_WARNING_HOURS_BEFORE_EXPIRY=24

# ---- Copy trading (app/copy_trading.py, app/copytrading_admin.py) ----
# Window in which the literal text "yes" from the same admin who ran
# /copytrading on actually flips the switch.
COPY_TRADING_CONFIRM_TTL_SECONDS=120
# Signals returned per GET /copy/feed poll.
COPY_FEED_MAX_SIGNALS=20
